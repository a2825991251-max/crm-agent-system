# Copy this file to .env.local. Never put a real key in this example file.
AI_PROVIDER_NAME=Cub2API
AI_API_KEY=
AI_MODEL=gpt-5.6-terra
AI_API_BASE=https://cubapi.codemao.cn/v1
AI_API_PROTOCOL=auto
OPENAI_TIMEOUT_SECONDS=60
AI_AGENT1_TIMEOUT_SECONDS=60
AI_AGENT1_MAX_MESSAGES=64
AI_AGENT1_MAX_CHARS=12000
AI_RETRY_ATTEMPTS=2

# Optional outbound messaging gateway.
CRM_SEND_WEBHOOK_URL=
